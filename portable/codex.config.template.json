    "apiKeyRef": "__API_KEY_REF__"
  },
  "mcpServers": {
    "ue-mcp": {
      "type": "stdio",
      "command": "__NPX_PATH__",
      "args": ["--yes", "ue-mcp@1.3.8", "__UE_PROJECT__"],
      "cwd": "__UE_PROJECT_DIR__",
      "mode": "direct",
      "startupTimeoutSec": 60,
      "toolTimeoutSec": 300,
      "disabled": "__UE_DISABLED__"
    }
  }
